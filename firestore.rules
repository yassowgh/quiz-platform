rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['yassow@gmail.com', 'yasser.ghallab@gmail.com'] ||
        (exists(/databases/$(database)/documents/config/admins) &&
         request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.get('emails', []))
      );
    }
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }
    // Collaborators are invited by email address.
    //
    // Requiring a verified address everywhere locked real people out of work
    // they were invited to, silently, twice. The risk it guards against is
    // somebody registering an address they do not own and inheriting what was
    // shared with it - which matters when the document holds exam answers, and
    // very little when it is an ordinary quiz. So verification is required for
    // exams only.
    function authEmail() {
      return (request.auth != null && request.auth.token.get('email', null) != null)
        ? request.auth.token.email.lower()
        : 'no-collaborator';
    }
    function verifiedEmail() {
      return (request.auth != null
              && request.auth.token.get('email_verified', false) == true
              && request.auth.token.get('email', null) != null)
        ? request.auth.token.email.lower()
        : 'no-collaborator';
    }
    // The address that counts for this document: verified if it is an exam.
    function claimFor(isExam) {
      return isExam ? verifiedEmail() : authEmail();
    }
    match /quizzes/{quizId} {
      allow read: if resource.data.get('examMode', false) != true
        || (request.auth != null && resource.data.hostId == request.auth.uid)
        || verifiedEmail() in resource.data.get('collabEditors', [])
        || verifiedEmail() in resource.data.get('collabHosts', [])
        || isAdmin();
      allow create: if request.auth != null && request.resource.data.hostId == request.auth.uid;
      // An editor may change the content but never the owner or the guest list.
      allow update: if request.auth != null && (
        resource.data.hostId == request.auth.uid
        || (claimFor(resource.data.get('examMode', false) == true) in resource.data.get('collabEditors', [])
            && request.resource.data.hostId == resource.data.hostId
            && request.resource.data.get('examMode', false) == resource.data.get('examMode', false)
            && request.resource.data.get('collabEditors', []) == resource.data.get('collabEditors', [])
            && request.resource.data.get('collabHosts', []) == resource.data.get('collabHosts', []))
      );
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }
    match /games/{gameId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.hostId == request.auth.uid || (resource.data.playerIds != null && resource.data.playerIds.hasAny([request.auth.uid]))));
      allow create: if request.auth != null && request.resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null && resource.data.hostId == request.auth.uid;
      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if true;
      }
    }
    match /assignments/{assignmentId} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && resource.data.hostId == request.auth.uid);
    }
    // Referral programme. A code maps to the host who owns it and must be
    // publicly readable so an invite link can be resolved before signing up.
    match /referralCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    // One row per referred person, keyed by their own uid so nobody can be
    // counted twice. They write it; the referrer and admins can read it.
    match /referrals/{refereeUid} {
      allow create: if request.auth != null
        && request.auth.uid == refereeUid
        && request.resource.data.refereeUid == request.auth.uid
        && request.resource.data.referrerUid is string
        && request.resource.data.referrerUid != request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid == refereeUid
        && request.resource.data.referrerUid == resource.data.referrerUid;
      allow read: if request.auth != null && (
        request.auth.uid == refereeUid
        || resource.data.referrerUid == request.auth.uid
        || isAdmin()
      );
    }
    match /pins/{pin} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pages/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /feedback/{fid} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /campaigns/{cid} {
      allow read, write: if isAdmin();
    }
    match /examAttempts/{attemptId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /examPublic/{quizId} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.hostId == request.auth.uid;
    }
  }
}
